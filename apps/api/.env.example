NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://usuario:senha@localhost:5432/diario_de_obra
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=12h
# Origem(ns) do front, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=diario-de-obra

# Correção de texto (LanguageTool). Padrão: API pública gratuita (com limite de uso).
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check

# Administrador inicial (criado só se ainda não existir nenhum usuário)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ZapSign (assinatura digital dos relatórios). Sem o token, o PDF é gerado mas não é enviado para assinatura.
ZAPSIGN_API_TOKEN=
ZAPSIGN_API_URL=https://api.zapsign.com.br/api/v1
ZAPSIGN_SIGNER_NAME=
ZAPSIGN_SIGNER_EMAIL=
